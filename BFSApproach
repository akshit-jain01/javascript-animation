#include <iostream>
#include <vector>
#include <queue>
using namespace std;

vector<int> BFSOfGraph(int V, vector<int> adj_lst[], vector<int>& visited, int start){
    vector<int> bfs;
    queue<int> q;

    visited[start] = 1;
    q.push(start);

    while(!q.empty()){
        int val = q.front();
        q.pop();
        bfs.push_back(val);

        for(auto iterator: adj_lst[val]){
            if(!visited[iterator]){
                visited[iterator] = 1;
                q.push(iterator);
            }
        }
    }
    return bfs;
}

int connected_comp(int V, vector<int> adj_lst[]){
    vector<int> visited(V, 0);
    int count = 0;
    for(int i = 0;i<V;i++){
        if(visited[i]==0){
            count++;
            BFSOfGraph(V, adj_lst, visited, i);
        }
    }
    return count;
}

int main(){
    int v, e;
    cin>>v>>e;
    vector<int> adj_lst[v];
    for(int i = 0;i<e;i++){
        int a, b;
        cin>>a>>b;
        adj_lst[a].push_back(b);
        adj_lst[b].push_back(a); // undirected
    }

    int connected = connected_comp(v, adj_lst);
    cout<<connected<<endl;
    return 0;
}
